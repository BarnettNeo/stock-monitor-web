# -----------------------------
# 服务端配置
# -----------------------------
PORT=3001
SCAN_INTERVAL_MS=15000

# 钉钉通知 (可选)
WEBHOOK_URL=
WEBHOOK_URL_TOKEN=

# MySQL 数据库 (服务端)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_monitor
DB_USER=root
DB_PASSWORD=

# -----------------------------
# Python Agent 服务
# -----------------------------
AGENTS_BASE_URL=http://127.0.0.1:8009
AGENTS_PORT=8009
AGENTS_HISTORY_LIMIT=12
REDIS_URL=

# 大语言模型 (兼容 OpenAI 接口)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3-max

# 多 provider 路由（配合 agents/a2a/agent.yaml 的 provider 字段）
# 约定：LLM_BASE_URL_<PROVIDER>, LLM_API_KEY_<PROVIDER>, LLM_MODEL_<PROVIDER>
# 例如 provider: dashscope / zhipuai / deepseek
LLM_BASE_URL_DASHSCOPE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY_DASHSCOPE=
LLM_MODEL_DASHSCOPE=qwen-turbo

LLM_BASE_URL_ZHIPUAI=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_API_KEY_ZHIPUAI=
LLM_MODEL_ZHIPUAI=GLM-4-Flash-250414

LLM_BASE_URL_DEEPSEEK=https://api.deepseek.com
LLM_API_KEY_DEEPSEEK=
LLM_MODEL_DEEPSEEK=deepseek-chat

# -----------------------------
# RAG / 向量数据库 (Milvus)
# -----------------------------
# 使用 MILVUS_URI 或 (MILVUS_HOST + MILVUS_PORT)
# 本地默认值 (docker compose): http://127.0.0.1:19530
MILVUS_URI=
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_DB=
MILVUS_NEWS_COLLECTION=news_chunks

# 可选：如果您的 Milvus 架构使用不同的名称，请进行字段映射
MILVUS_NEWS_VECTOR_FIELD=embedding
MILVUS_NEWS_TEXT_FIELD=text
MILVUS_NEWS_TITLE_FIELD=title
MILVUS_NEWS_URL_FIELD=url
MILVUS_NEWS_SOURCE_FIELD=source
MILVUS_NEWS_PUBLISHED_FIELD=published_at
MILVUS_METRIC=COSINE

# -----------------------------
# 嵌入模型 (兼容 OpenAI 接口)
# -----------------------------
# 如果未设置，Agent 将尝试复用 LLM_BASE_URL/LLM_API_KEY。
# 示例 (SiliconFlow): https://api.siliconflow.cn/v1  模型: text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# 可选：为 Agent 启用 PostgreSQL 存储记忆
# 启用时，建议设置 AGENTS_POSTGRES_URL (推荐)。
AGENTS_USE_POSTGRES=
AGENTS_POSTGRES_URL=
PG_HOST=
PG_PORT=5432
PG_NAME=
PG_USER=
PG_PASSWORD=

# -----------------------------
# A2A 多智能体 (指挥官-执行者模式)
# -----------------------------
# 为每个 Agent 设置不同的模型 (必须在您的 LLM_BASE_URL 提供商中有效)。
# 如果为空，Agent 可能会回退到 LLM_MODEL 或确定的默认值。
A2A_MODEL_INGEST=
A2A_MODEL_RETRIEVAL=
A2A_MODEL_THINKING=

# -----------------------------
# 新闻抓取 (爬取/清洗/更新)
# -----------------------------
# 以逗号分隔的 RSS/Atom 订阅源。示例：
# NEWS_RSS_FEEDS=https://rsshub.app/36kr/newsflashes,https://rsshub.app/ifanr/latest
NEWS_RSS_FEEDS=https://rss.sina.com.cn/roll/stock/hot_roll.xml,https://rss.sina.com.cn/roll/finance/hot_roll.xml,https://rss.sina.com.cn/finance/jsy.xml,https://rss.sina.com.cn/news/allnews/finance.xml
NEWS_HTTP_TIMEOUT=15
NEWS_CHUNK_CHARS=1200
NEWS_CHUNK_OVERLAP=120

# -----------------------------
# 服务端抓取调度器 (定时任务/工作进程)
# -----------------------------
# 通过设置间隔时间 (毫秒) > 0 来启用。例如：300000 (5 分钟)
NEWS_INGEST_INTERVAL_MS=300000
# 如果为空，服务器将抓取从已启用策略中收集的股票代码 (最多 200 个)。
NEWS_INGEST_SYMBOLS=100
# 如果 <= 0，服务器将根据上次成功运行的时间自动计算增量窗口。
NEWS_INGEST_SINCE_MINUTES=180
NEWS_INGEST_MAX_ITEMS=30
