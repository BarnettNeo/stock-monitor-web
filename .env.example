# -----------------------------
# Server
# -----------------------------
PORT=3001
SCAN_INTERVAL_MS=15000

# DingTalk (optional)
WEBHOOK_URL=
WEBHOOK_URL_TOKEN=

# MySQL (server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_monitor
DB_USER=root
DB_PASSWORD=

# -----------------------------
# Python agents service
# -----------------------------
AGENTS_BASE_URL=http://127.0.0.1:8009
AGENTS_PORT=8009
AGENTS_HISTORY_LIMIT=12
REDIS_URL=

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3-max

# -----------------------------
# RAG / Vector DB (Milvus)
# -----------------------------
# Use either MILVUS_URI or (MILVUS_HOST + MILVUS_PORT)
# Local default (docker compose): http://127.0.0.1:19530
MILVUS_URI=
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_DB=
MILVUS_NEWS_COLLECTION=news_chunks

# Optional: field mapping if your Milvus schema uses different names
MILVUS_NEWS_VECTOR_FIELD=embedding
MILVUS_NEWS_TEXT_FIELD=text
MILVUS_NEWS_TITLE_FIELD=title
MILVUS_NEWS_URL_FIELD=url
MILVUS_NEWS_SOURCE_FIELD=source
MILVUS_NEWS_PUBLISHED_FIELD=published_at
MILVUS_METRIC=COSINE

# -----------------------------
# Embeddings (OpenAI-compatible)
# -----------------------------
# If unset, agents will try to reuse LLM_BASE_URL/LLM_API_KEY.
# Example (SiliconFlow): https://api.siliconflow.cn/v1  model: text-embedding-v3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# Optional: enable PostgreSQL-backed memory for agents
# When enabled, prefer setting AGENTS_POSTGRES_URL (recommended).
AGENTS_USE_POSTGRES=
AGENTS_POSTGRES_URL=
PG_HOST=
PG_PORT=5432
PG_NAME=
PG_USER=
PG_PASSWORD=
